[Unit]
Description=account.yydsxwh.com account center
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/var/www/account
EnvironmentFile=/var/www/account/.env.production
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3003
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
