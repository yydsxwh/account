generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 账号：邮箱 / 登录名 / 手机 / 微信 四种方式可指向同一用户
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  passwordSet  Boolean @default(true)
  name         String
  username     String? @unique
  bio          String  @default("")
  avatarUrl    String  @default("")
  phone        String  @default("")
  role         String  @default("STUDENT")
  roles        String  @default("")
  requestedRole         String @default("")
  roleApplicationStatus String @default("NONE")
  roleApplicationNote   String @default("")
  roleReviewedAt        DateTime?
  roleReviewedById      String?
  adminNote             String @default("")
  wechatOpenId       String @default("")
  wechatWebOpenId    String @default("")
  wechatMobileOpenId String @default("")
  wechatUnionId      String @default("")
  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productSyncStates ProductSyncState[]

  @@index([roleApplicationStatus])
  @@index([phone])
  @@index([wechatOpenId])
  @@index([wechatWebOpenId])
  @@index([wechatMobileOpenId])
  @@index([wechatUnionId])
  @@index([name])
}

/// Cross-product cloud snapshot storage. One row per user/product.
model ProductSyncState {
  id        String   @id @default(cuid())
  userId    String
  product   String
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
  @@index([userId, updatedAt])
}

/// 短信验证码（手机号登录 / 绑定）；哈希存储，短时有效
model SmsCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

/// 站长系统设置（短信 / 微信授权），单例 id = default
model SiteSettings {
  id String @id @default("default")
  siteUrl String @default("")
  wechatAppId           String @default("")
  wechatAppSecret       String @default("")
  wechatWebAppId        String @default("")
  wechatWebAppSecret    String @default("")
  wechatMobileAppId     String @default("")
  wechatMobileAppSecret String @default("")
  smsEnabled         Boolean @default(true)
  smsProvider        String  @default("test")
  smsAccessKeyId     String  @default("")
  smsAccessKeySecret String  @default("")
  smsSignName        String  @default("")
  smsTemplateCode    String  @default("")
  smsTestMode        Boolean @default(true)
  smsTestFixedCode   String  @default("123456")
  updatedAt DateTime @updatedAt
}
