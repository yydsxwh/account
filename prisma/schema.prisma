generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 账号：kk号 / 自设账号 / 邮箱 / 手机 / 微信 可指向同一用户
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  /// 是否已设置可用登录密码；手机/微信自动注册且未设密码时为 false
  passwordSet  Boolean @default(true)
  name         String
  /// 系统自动分配的 kk 号（类似 QQ 号），从 3 位数起，越早越短
  kkNumber     Int?    @unique
  /// 可自设账号（类似微信号，英文+数字）；空/null 表示尚未设置
  username     String? @unique
  bio          String  @default("")
  avatarUrl    String  @default("")
  /// 手机号登录用；空表示未绑定
  phone        String  @default("")
  /// ADMIN 站长 | AGENT 加盟代理 | MERCHANT 入驻商家 | TEACHER 老师 | STUDENT 用户
  role         String  @default("STUDENT")
  /// 多角色：逗号分隔；空则仅用 role
  roles        String  @default("")
  requestedRole         String @default("")
  roleApplicationStatus String @default("NONE")
  roleApplicationNote   String @default("")
  roleReviewedAt        DateTime?
  roleReviewedById      String?
  adminNote             String @default("")
  wechatOpenId       String @default("")
  wechatWebOpenId    String @default("")
  wechatMobileOpenId String @default("")
  wechatUnionId      String @default("")
  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleApplicationStatus])
  @@index([phone])
  @@index([wechatOpenId])
  @@index([wechatWebOpenId])
  @@index([wechatMobileOpenId])
  @@index([wechatUnionId])
  @@index([name])
}

/// kk 号发号器：next 为下一个将发出的数字
model KkSequence {
  id   String @id @default("default")
  next Int    @default(100)
}

/// 短信验证码（手机号登录 / 绑定）；哈希存储，短时有效
model SmsCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  /// login | bind
  purpose   String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

/// 站长系统设置（短信 / 微信授权），单例 id = default
model SiteSettings {
  id String @id @default("default")

  siteUrl String @default("")

  wechatAppId           String @default("")
  wechatAppSecret       String @default("")
  wechatWebAppId        String @default("")
  wechatWebAppSecret    String @default("")
  wechatMobileAppId     String @default("")
  wechatMobileAppSecret String @default("")

  smsEnabled         Boolean @default(true)
  smsProvider        String  @default("test")
  smsAccessKeyId     String  @default("")
  smsAccessKeySecret String  @default("")
  smsSignName        String  @default("")
  smsTemplateCode    String  @default("")
  smsTestMode        Boolean @default(true)
  smsTestFixedCode   String  @default("123456")

  updatedAt DateTime @updatedAt
}

/// 接入账号中心的软件产品（第一方应用）
model OAuthClient {
  id           String   @id @default(cuid())
  /// 给产品配置的公开 ID，如 docs / shop
  clientId     String   @unique
  /// bcrypt 后的密钥；明文只在创建时展示一次
  clientSecret String
  name         String
  /// 产品首页，个人中心「打开」用
  homepageUrl  String   @default("")
  /// JSON 字符串数组：登录成功后允许跳回的地址
  redirectUris String   @default("[]")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 一次性授权码：产品用它向账号中心换用户
model OAuthCode {
  id          String    @id @default(cuid())
  code        String    @unique
  clientId    String
  userId      String
  redirectUri String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([expiresAt])
}

/// 产品服务端持有的访问令牌
model OAuthAccessToken {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
