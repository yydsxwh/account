# 这里全部是示例值。真实密钥只放服务器上的 .env，不要提交。
AUTH_SECRET="change-me-to-a-long-random-string"
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 同父域名多产品共享登录 Cookie，例如 .yydsxwh.com（遗留方案，新产品请走 OIDC）
# COOKIE_DOMAIN=".yydsxwh.com"

# —— OpenID Connect ——
# issuer 必须和产品侧配置的完全一致；不填则用 NEXT_PUBLIC_SITE_URL
# OIDC_ISSUER="http://localhost:3000"
# ID Token 签名私钥（PKCS#8 PEM）。不填时会自动生成一把存进数据库，
# 单机够用；多实例部署必须显式配置，否则各实例签的 token 互相验不过。
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out oidc.pem
# OIDC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OIDC_KEY_ID=""

# 阿里云短信：库里关掉测试模式并填齐 AccessKey 后，验证码发到用户手机
# SMS_ENABLED="1"
# SMS_ACCESS_KEY_ID=""
# SMS_ACCESS_KEY_SECRET=""
# SMS_SIGN_NAME="歪歪滴艾斯杭州科技"
# SMS_TEMPLATE_CODE="SMS_512395568"
# SMS_TEST_FIXED_CODE="123456"

# 微信公众号网页授权（微信内登录）
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# 微信开放平台「网站应用」扫码登录
WECHAT_WEB_APP_ID=""
WECHAT_WEB_APP_SECRET=""

# 微信开放平台「移动应用」Android SDK 登录
WECHAT_MOBILE_APP_ID=""
WECHAT_MOBILE_APP_SECRET=""
