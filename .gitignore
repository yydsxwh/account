# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env.production.example

# prisma / sqlite
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal
/data

# OIDC 签名私钥：只放服务器和环境变量，永远不要提交
*.pem
*.key
oidc*.pem

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js auto-generated agent rule files
/AGENTS.md
/CLAUDE.md

# uploaded media
/public/uploads
/uploads

# python bytecode
__pycache__/
*.pyc
