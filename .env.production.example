AUTH_SECRET="请改成一长串随机字符"
# Docker 卷用 file:/data/prod.db；本机 systemd 用下面这条
DATABASE_URL="file:/var/www/account/data/prod.db"
NEXT_PUBLIC_SITE_URL="https://account.yydsxwh.com"
COOKIE_DOMAIN=".yydsxwh.com"

BOOTSTRAP_ADMIN_EMAIL="你的站长邮箱"
BOOTSTRAP_ADMIN_PASSWORD="请改成强密码"
BOOTSTRAP_ADMIN_NAME="站长"

# 短信：库里的「测试模式」开关为准。只有紧急回退才设 SMS_FORCE_TEST_MODE=1
SMS_ENABLED="1"
SMS_TEST_FIXED_CODE="123456"
# 填了 AccessKey 并在后台关掉测试模式后，验证码发到手机
# SMS_ACCESS_KEY_ID=""
# SMS_ACCESS_KEY_SECRET=""
# SMS_SIGN_NAME="歪歪滴艾斯杭州科技"
# SMS_TEMPLATE_CODE="SMS_512395568"
